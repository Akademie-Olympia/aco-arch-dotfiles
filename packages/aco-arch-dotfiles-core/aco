#!/usr/bin/env bash
# Pacman is the only updater. Never mutate a Git checkout or /usr at runtime.
set -euo pipefail
case "${1:-help}" in
    install|setup|init|links|symlinks)
        shift
        exec aco-arch-dotfiles-config activate "$@" ;;
    deactivate|status|check|sync)
        command=$1; shift
        [[ $command == check ]] && command=status
        [[ $command == sync ]] && command=update
        exec aco-arch-dotfiles-config "$command" "$@" ;;
    update|upgrade|up)
        shift
        if [[ $# -gt 0 && $1 != all && $1 != system ]]; then
            echo 'Updates are system-wide: use aco update (no partial upgrades).' >&2
            exit 2
        fi
        sudo pacman -Syu
        exec aco-arch-dotfiles-config update ;;
    packages|pkgs)
        shift
        exec sudo pacman -Syu --needed "${@:-aco-arch-dotfiles}" ;;
    list|ls|modules)
        pacman -Q | awk '$1 ~ /^aco-arch-dotfiles($|-)/'
        ;;
    path)
        printf '%s\n' "${XDG_DATA_HOME:-$HOME/.local/share}/arch-dotfiles/config" ;;
    keys|shortcuts)
        shift
        exec aco-arch-dotfiles-keys "$@" ;;
    docs)
        printf '%s\n' 'https://aco-arch-dotfiles.readthedocs.io/en/latest/'
        printf '%s\n' 'See also each installed module README in /usr/share/arch-dotfiles/<module>.' ;;
    commands)
        cat <<'HELP'
aco update                  pacman -Syu, then merge defaults safely
aco sync                    merge defaults after running pacman yourself
aco packages <package>...    install packages with a full system upgrade
aco install [module]...      activate installed modules (without sudo)
aco deactivate [module]...   restore previous settings
aco keys [--menu] [app]...   searchable list of all shortcuts (Hyprland: Super+K)
aco status / aco list       inspect activation / installed packages
HELP
        ;;
    scripts)
        printf '%s\n' /usr/bin/aco /usr/bin/aco-arch-dotfiles-config /usr/bin/aco-arch-dotfiles-keys /usr/bin/aco-arch-dotfiles-registry-kick
        for script in screenshot wallpaper; do command -v "$script" || true; done ;;
    subtrees|subtree|pull|push|wallpapers)
        echo 'Subtree/Git updates have been retired. Use pacman -Syu; manage private pictures separately.' >&2
        exit 1 ;;
    help|-h|--help)
        "$0" commands
        printf '%s\n' 'Optional automatic user sync: systemctl --user enable --now aco-arch-dotfiles-sync.timer'
        printf '%s\n' 'Optional automatic registry reconciliation (needs gh auth): systemctl --user enable --now aco-arch-dotfiles-registry-kick.timer' ;;
    *) echo "Unknown command: $1" >&2; exit 2 ;;
esac
